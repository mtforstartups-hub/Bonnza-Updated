# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL & Environment
APP_URL="https://bonnza.marketingtusk.com"
PUBLIC_SITE_URL="https://bonnza.marketingtusk.com"
APP_ENV="development"
NODE_ENV="development"
DATABASE_URL=""

# Session & CSRF Signing Secrets (Never expose to client)
SESSION_SECRET="replace-with-strong-session-secret-in-production"
CSRF_SECRET="replace-with-strong-csrf-secret-in-production"
ADMIN_BOOTSTRAP_EMAIL="mtforstartups@gmail.com"

# Commercial, Legal & Release Readiness Feature Flags (Default: false)
WEBINAR_CHECKOUT_ENABLED="false"
WEBINAR_PRICING_APPROVED="false"
LEGAL_POLICY_APPROVED="false"
MERCHANT_VERIFIED="false"
COURSE_CHECKOUT_ENABLED="false"
BUNDLE_CHECKOUT_ENABLED="false"
PUBLIC_INDEXING_ENABLED="false"
ANALYTICS_CONSENT_REQUIRED="true"
REPLAY_ENABLED="false"

# Webinar Delivery Configuration
WEBINAR_PROVIDER="private_room"
WEBINAR_JOINING_ENABLED="false"

# Razorpay Payment Provider Credentials (Server-side only; never expose SECRET to client)
RAZORPAY_MODE="inactive"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CHECKOUT_URL=""
VITE_RAZORPAY_CHECKOUT_URL=""

# Transactional Email Outbox Configuration
EMAIL_PROVIDER="outbox_queue"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="bonnza@marketingtusk.com"
EMAIL_REPLY_TO="bonnza@marketingtusk.com"

# Analytics, Search Console & Attribution Configuration (Loaded only after consent & config)
GA4_MEASUREMENT_ID=""
GSC_VERIFICATION_TOKEN=""
CLARITY_PROJECT_ID=""
BING_VERIFICATION_TOKEN=""
META_PIXEL_ID=""
