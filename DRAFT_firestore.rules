rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedUser() && request.auth.token.email == 'mtforstartups@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedOwner() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && data.role.size() <= 32 &&
        data.role in ['OWNER', 'ADMIN', 'CONTENT_EDITOR', 'WEBINAR_OPERATOR', 'FACULTY_REVIEWER', 'SUPPORT_AGENT', 'LEARNER'] &&
        data.createdAt is timestamp;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll([
          'registrationReference',
          'ownerUid',
          'sessionId',
          'paymentState',
          'amountPaise',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'registrationReference',
          'ownerUid',
          'sessionId',
          'paymentState',
          'amountPaise',
          'createdAt',
          'updatedAt'
        ]) &&
        data.registrationReference is string &&
        data.registrationReference.size() >= 3 &&
        data.registrationReference.size() <= 64 &&
        data.registrationReference.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.sessionId is string &&
        data.sessionId.size() <= 64 &&
        data.sessionId in ['bonnza-2026-12-05-en-1300', 'bonnza-2026-12-05-hi-1600'] &&
        data.paymentState is string &&
        data.paymentState.size() <= 32 &&
        data.paymentState in [
          'DRAFT',
          'PAYMENT_INITIATED',
          'PENDING_VERIFICATION',
          'PAID_CONFIRMED',
          'PAYMENT_FAILED',
          'EXPIRED',
          'REFUND_PENDING',
          'REFUNDED',
          'CHARGEBACK',
          'MANUAL_REVIEW'
        ] &&
        data.amountPaise is int &&
        data.amountPaise == 29900 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.actorUid is string &&
        data.actorUid.size() >= 1 &&
        data.actorUid.size() <= 128 &&
        data.actorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
        data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 80 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.targetId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email']);
      allow delete: if isBootstrappedOwner() && isValidId(adminUid);
    }

    match /registrations/{registrationId} {
      allow get: if isVerifiedUser() &&
        isValidId(registrationId) &&
        (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(registrationId) &&
        isValidRegistration(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().paymentState == 'DRAFT' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(registrationId) &&
        isValidRegistration(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().registrationReference == existing().registrationReference &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            !(existing().paymentState in ['REFUNDED', 'EXPIRED', 'PAID_CONFIRMED']) &&
            incoming().paymentState == existing().paymentState &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sessionId', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(registrationId);
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
